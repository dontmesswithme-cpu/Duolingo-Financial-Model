# Universal Autonomous Multi-Agent Engineering Framework Configuration
# Copy this file to .env and configure for your project.

# Maximum time (in ms) background watchers will poll before timing out (default: 7200000 = 2 hours)
WORKFLOW_WATCHER_TIMEOUT_MS=7200000

# Automatically commit and tag Git repository upon Gate Pass (default: true)
WORKFLOW_AUTO_GIT=true

# Tag prefix for milestone releases (produces v1.0-P0, v1.0-P1, etc.)
WORKFLOW_GIT_TAG_PREFIX=v1.0

# Optional Discord / Slack webhook URL for milestone notifications
# WORKFLOW_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Project name displayed in webhook milestone announcements
WORKFLOW_PROJECT_NAME="Duolingo FM"
